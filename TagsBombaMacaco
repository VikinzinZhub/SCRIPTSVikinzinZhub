local AntiLavaPlatform = nil
local PLATFORM_HEIGHT_OFFSET = 40

local function ControlAntiLavaPlatform()
    game:GetService("RunService").Heartbeat:Connect(function()
        local lavaY = GetLavaHeight()
        
        if lavaY ~= -math.huge then
            local targetY = lavaY + PLATFORM_HEIGHT_OFFSET
            LavaAvisoLabel.Visible = true
            
