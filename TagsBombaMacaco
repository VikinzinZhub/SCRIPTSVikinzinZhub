-- ─── DETECTOR DE TEMPO RESTANTE DA BOMBA ─────────────────────────
local function GetBombTime()
    local debris = workspace:FindFirstChild("Debris")
    local defaultFolder = debris and debris:FindFirstChild("Default")
    local bombTimer = defaultFolder and defaultFolder:FindFirstChild("BombTimer")
    
    if bombTimer and bombTimer:IsA("ValueBase") then
        return tonumber(bombTimer.Value) or 99
    elseif bombTimer and bombTimer:IsA("BasePart") then
        local textLabel = bombTimer:FindFirstChildWhichIsA("TextLabel", true)
        if textLabel then
            local timeText = textLabel.Text:match("[%d%.]+")
            return tonumber(timeText) or 99
        end
    end
    return 99
end

-- ─── FUNÇÃO DE ÓRBITA COM PREDICT ───────────────────────────────
local orbitAngle = 0
local function TeleportToNearest()
    local myCharacter = Player.Character
    local myHRP = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    
    local lavaY = GetLavaHeight()
    local limiteAlturaMinima = -math.huge
    if lavaY ~= -math.huge then
        limiteAlturaMinima = lavaY + PLATFORM_HEIGHT_OFFSET - 5
    end
    
    local nearestPlayer, shortestDistance = nil, math.huge
    for _, other in pairs(Players:GetPlayers()) do
        if other ~= Player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
            local char = other.Character
            local oHRP = char.HumanoidRootPart
            local hum = char:FindFirstChildOfClass("Humanoid")
            local head = char:FindFirstChild("Head")
            
            if not hum or hum.Health <= 0 then continue end
            if head and head.Transparency > 0.5 then continue end
            if oHRP.Position.Y < limiteAlturaMinima or oHRP.Velocity.Y < -20 then continue end
            
            local bomb = workspace:FindFirstChild("Bomb")
            if bomb and bomb:FindFirstChild(other.Name) then continue end
            
            local dist = (oHRP.Position - myHRP.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                nearestPlayer = oHRP
            end
        end
    end
    
    if nearestPlayer then 
        myHRP.Velocity = Vector3.new(0, 0, 0)
        local radius = 3.2 
        local speed = 0.40  
        orbitAngle = orbitAngle + speed
        
        local oVelocity = nearestPlayer.Velocity
        local predictPosition = nearestPlayer.Position + (oVelocity * 0.08)
        local offsetX = math.cos(orbitAngle) * radius
        local offsetZ = math.sin(orbitAngle) * radius
        
        myHRP.CFrame = CFrame.new(predictPosition + Vector3.new(offsetX, 0.5, offsetZ), predictPosition)
        pcall(function()
            firetouchinterest(myHRP, nearestPlayer, 0)
            firetouchinterest(myHRP, nearestPlayer, 1)
        end)
    end
end

