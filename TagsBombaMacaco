PanicBtn.MouseButton1Click:Connect(function()
    local char = Player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    getgenv().VikinzinZ_ManualSky = not getgenv().VikinzinZ_ManualSky
    
    if getgenv().VikinzinZ_ManualSky then
        PanicBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 120)
        SetNoclip(true)
        
        if not stabilityForce or stabilityForce.Parent ~= hrp then
            if stabilityForce then stabilityForce:Destroy() end
            stabilityForce = Instance.new("BodyVelocity")
            stabilityForce.Velocity = Vector3.new(0, 0, 0)
            stabilityForce.Parent = hrp
        end
        
        -- Loop Inteligente: Fica a 400 studs mas CHECA se pegou a bomba de segundo em segundo
        task.spawn(function()
            while getgenv().VikinzinZ_ManualSky and hrp and hrp.Parent do
                local bombFolder = workspace:FindFirstChild("Bomb")
                local estouComABomba = bombFolder and bombFolder:FindFirstChild(Player.Name)
                
                if estouComABomba then
                    -- EMERGÊNCIA: Libera a física e descarrega a bomba no cara!
                    stabilityForce.MaxForce = Vector3.new(0, 0, 0)
                    SetNoclip(false)
                    TeleportToNearest()
                else
                    -- SEGURO: Trava totalmente imóvel nos 400 studs
                    SetNoclip(true)
                    stabilityForce.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    hrp.CFrame = CFrame.new(hrp.Position.X, 400, hrp.Position.Z)
                    hrp.Velocity = Vector3.new(0,0,0)
                end
                task.wait(0.01)
            end
        end)
    else
        PanicBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        if not getgenv().VikinzinZ_Storage.AutoWin then
            if stabilityForce then stabilityForce:Destroy() stabilityForce = nil end
            SetNoclip(false)
        else
            stabilityForce.MaxForce = Vector3.new(0, math.huge, 0)
        end
    end
end)

