local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Player = LocalPlayer

-- Sistema de Persistência
local SavePath = "VikinzinZ_Config.json"
local function SaveConfig(data)
    if writefile then writefile(SavePath, HttpService:JSONEncode(data)) end
end

local function LoadConfig()
    if isfile and isfile(SavePath) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SavePath))
        end)
        if success and result then return result end
    end
    return {AutoBanana = false, AutoWin = false, ColetaSpeed = 0.05}
end

getgenv().VikinzinZ_Storage = LoadConfig()

-- ─── FUNÇÃO PARA PASSAR A BOMBA ──────────────────────
local function TeleportToNearest()
    local myHRP = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local nearestPlayer, shortestDistance = nil, math.huge
    for _, other in pairs(Players:GetPlayers()) do
        if other ~= Player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
            local bomb = workspace:FindFirstChild("Bomb")
            if bomb and bomb:FindFirstChild(other.Name) then continue end
            
            local dist = (other.Character.HumanoidRootPart.Position - myHRP.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                nearestPlayer = other.Character.HumanoidRootPart
            end
        end
    end
    if nearestPlayer then myHRP.CFrame = nearestPlayer.CFrame end
end

