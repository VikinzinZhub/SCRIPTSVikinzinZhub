-- ─── CACHE DA LAVA OTIMIZADO ────────────────────────────────────
local cachedLava = nil
local lastLavaCheck = 0

local function GetLavaHeight()
    if tick() - lastLavaCheck < 0.3 then
        if cachedLava and cachedLava.Parent then
            return cachedLava.Position.Y + (cachedLava.Size.Y / 2)
        end
        return -math.huge
    end
    
    lastLavaCheck = tick()
    cachedLava = nil
    local lavaHeight = -math.huge
    
    local mapFolder = workspace:FindFirstChild("Map")
    if mapFolder then
        for _, obj in pairs(mapFolder:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name == "RisingLava" or obj.Name:lower():find("lava")) then
                cachedLava = obj
                local topY = obj.Position.Y + (obj.Size.Y / 2)
                if topY > lavaHeight then lavaHeight = topY end
            end
        end
    end
    return lavaHeight
end

-- ─── FUNÇÃO DE INVISIBILIDADE LOCAL (MODO FANTASMA) ──────────────
local function SetGhostMode(active)
    local char = Player.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Decal") then
            if active then
                if not part:GetAttribute("OriginalTransparency") then
                    part:SetAttribute("OriginalTransparency", part.Transparency)
                end
                part.Transparency = 1
            else
                local orig = part:GetAttribute("OriginalTransparency")
                if orig then
                    part.Transparency = orig
                end
            end
        end
    end
end

