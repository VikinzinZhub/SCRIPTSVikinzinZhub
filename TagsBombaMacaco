-- ─── LÓGICA DO ÍMÃ DE BANANAS TOTALMENTE LISO + NOCLIP ───
local function AutoColetar()
    while getgenv().VikinzinZ_Storage.AutoBanana do
        local character = Player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local bananasFolder = workspace:FindFirstChild("Bananas")
        
        if hrp and bananasFolder then
            local lavaY = GetLavaHeight()
            if lavaY ~= -math.huge and hrp.Position.Y < (lavaY + 30) then
                SetNoclip(true)
                hrp.CFrame = CFrame.new(hrp.Position.X, lavaY + 40, hrp.Position.Z)
            end

            local bananas = bananasFolder:GetChildren()
            for _, b in pairs(bananas) do
                if not getgenv().VikinzinZ_Storage.AutoBanana then break end
                
                if b:IsA("BasePart") then
                    b.CFrame = hrp.CFrame
                elseif b:IsA("Model") then
                    b:ScaleTo(1)
                    b:PivotTo(hrp.CFrame)
                end
                
                local touch = b:FindFirstChildWhichIsA("TouchInterest", true)
                if touch and character:FindFirstChild("LeftFoot") then
                    firetouchinterest(character.LeftFoot, b, 0)
                    firetouchinterest(character.LeftFoot, b, 1)
                end
                task.wait(getgenv().VikinzinZ_Storage.ColetaSpeed)
            end
        end
        task.wait(0.05)
    end
    if not getgenv().VikinzinZ_Storage.AutoWin and not getgenv().VikinzinZ_ManualSky then SetNoclip(false) end
end

-- ─── LÓGICA DO AUTO WIN GERAL ───
local stabilityForce = nil

local function LoopAutoWin()
    while getgenv().VikinzinZ_Storage.AutoWin do
        -- Se o botão manual estiver ativo, o AutoWin deixa ele mandar na altura (exceto se pegar a bomba)
        local bombFolder = workspace:FindFirstChild("Bomb")
        local comBomba = bombFolder and bombFolder:FindFirstChild(Player.Name)

        if getgenv().VikinzinZ_ManualSky and not comBomba then 
            task.wait(0.05) 
            continue 
        end

        local myCharacter = Player.Character
        local myHRP = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        if myHRP and bombFolder then
            if not stabilityForce or stabilityForce.Parent ~= myHRP then
                if stabilityForce then stabilityForce:Destroy() end
                stabilityForce = Instance.new("BodyVelocity")
                stabilityForce.Velocity = Vector3.new(0, 0, 0)
                stabilityForce.MaxForce = Vector3.new(0, math.huge, 0)
                stabilityForce.Parent = myHRP
            end

            if comBomba then
                SetNoclip(false)
                stabilityForce.MaxForce = Vector3.new(0, 0, 0)
                TeleportToNearest()
            else
                local timeRemaining = GetBombTime()
                local lavaY = GetLavaHeight()
                
                if timeRemaining <= 5 then
                    SetNoclip(true)
                    stabilityForce.MaxForce = Vector3.new(0, math.huge, 0)
                    myHRP.CFrame = CFrame.new(myHRP.Position.X, 400, myHRP.Position.Z)
                else
                    local perigoPerto = false
                    for _, bomber in pairs(bombFolder:GetChildren()) do
                        if bomber:IsA("Model") and bomber:FindFirstChild("HumanoidRootPart") and bomber.Name ~= Player.Name then
                            local posInimigo = Vector3.new(bomber.HumanoidRootPart.Position.X, 0, bomber.HumanoidRootPart.Position.Z)
                            local posMinha = Vector3.new(myHRP.Position.X, 0, myHRP.Position.Z)
                            local dist = (posInimigo - posMinha).Magnitude
                            
                            if dist < 25 then perigoPerto = true break end
                        end
                    end
                    
                    if perigoPerto then
                        SetNoclip(true)
                        stabilityForce.MaxForce = Vector3.new(0, math.huge, 0)
                        if lavaY ~= -math.huge then
                            myHRP.CFrame = CFrame.new(myHRP.Position.X, lavaY + 150, myHRP.Position.Z)
                        else
                            myHRP.CFrame = CFrame.new(myHRP.Position.X, 160, myHRP.Position.Z)
                        end
                    else
                        if lavaY ~= -math.huge then
                            SetNoclip(true)
                            stabilityForce.MaxForce = Vector3.new(0, math.huge, 0)
                            myHRP.CFrame = CFrame.new(myHRP.Position.X, lavaY + 45, myHRP.Position.Z)
                        else
                            SetNoclip(false)
                            stabilityForce.MaxForce = Vector3.new(0, 0, 0)
                        end
                    end
                end
            end
        else
            if stabilityForce then stabilityForce:Destroy() stabilityForce = nil end
        end
        task.wait(0.01)
    end
    
    if stabilityForce and not getgenv().VikinzinZ_ManualSky then stabilityForce:Destroy() stabilityForce = nil end
    if not getgenv().VikinzinZ_ManualSky then SetNoclip(false) end
end

