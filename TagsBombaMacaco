getgenv().VikinzinZ_ManualSky = false
local PanicGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
PanicGui.Name = "VikinzinZ_Panic_Button"

local PanicBtn = Instance.new("TextButton", PanicGui)
PanicBtn.Size = UDim2.new(0, 42, 0, 42)
PanicBtn.Position = UDim2.new(1, -60, 0, 80)
PanicBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
