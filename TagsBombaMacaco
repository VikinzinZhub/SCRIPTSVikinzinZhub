-- ─── LÓGICA DE SERVIDOR PEQUENO COM AUTOEXEC PREVENTIVO ──────────
local function HopToSmallServer()
    AplicarAutoExecuteTeleport() 
    
    local apiURL = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, serverData = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(apiURL))
    end)
    
    if success and serverData and serverData.data then
        for _, server in pairs(serverData.data) do
            if server.id ~= game.JobId and tonumber(server.playing) < tonumber(server.maxPlayers) then
                if tonumber(server.playing) >= 1 then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, Player)
                    return
                end
            end
        end
    end
    pcall(function() TeleportService:Teleport(game.PlaceId, Player) end)
end

-- ─── LÓGICA: ÍMÃ DE BANANAS ULTRA INSTANTÂNEO ────────────────────
local function AutoColetar()
    while getgenv().VikinzinZ_Storage.AutoBanana do
        local character = Player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local bananasFolder = workspace:FindFirstChild("Bananas")
        
        if hrp and bananasFolder then
            for _, b in pairs(bananasFolder:GetChildren()) do
                if b:IsA("BasePart") then
                    b.CFrame = hrp.CFrame
                elseif b:IsA("Model") then
                    b:ScaleTo(1)
                    b:PivotTo(hrp.CFrame)
                end
                local touch = b:FindFirstChildWhichIsA("TouchInterest", true)
                if touch and character:FindFirstChild("LeftFoot") then
                    firetouchinterest(character.LeftFoot, b, 0)
                    firetouchinterest(character.LeftFoot, b, 1)
                end
            end
        end
        task.wait(getgenv().VikinzinZ_Storage.ColetaSpeed)
    end
end

-- ─── MONITORAMENTO DO HOP AUTOMÁTICO COM AUTOEXEC ────────────────
local function LoopAutoHopMonitor()
    while getgenv().VikinzinZ_Storage.AutoHopSmall do
        local bananasFolder = workspace:FindFirstChild("Bananas")
        local totalBananas = 0
        
        if bananasFolder then
            for _, b in pairs(bananasFolder:GetChildren()) do
                if b:IsA("BasePart") or b:IsA("Model") then
                    totalBananas = totalBananas + 1
                end
            end
        end
        
        if totalBananas == 0 and getgenv().VikinzinZ_Storage.AutoHopSmall then
            SaveConfig(getgenv().VikinzinZ_Storage)
            HopToSmallServer()
            break 
        end
        task.wait(0.1) 
    end
end

