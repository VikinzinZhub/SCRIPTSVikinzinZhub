-- Sistema de Persistência
local SavePath = "VikinzinZ_Config.json"
local function SaveConfig(data)
    if writefile then writefile(SavePath, HttpService:JSONEncode(data)) end
end

local function LoadConfig()
    if isfile and isfile(SavePath) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SavePath))
        end)
        if success and result then return result end
    end
    return {AutoBanana = false, AutoWin = false, ColetaSpeed = 0.05}
end

getgenv().VikinzinZ_Storage = LoadConfig()

-- ─── SISTEMA DE NOCLIP REAL INDESTRUTÍVEL ──────────────────
local noclipConnection = nil
local function SetNoclip(active)
    if active then
        if not noclipConnection then
            noclipConnection = game:GetService("RunService").Stepped:Connect(function()
                if Player.Character then
                    for _, part in pairs(Player.Character:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

-- ─── CACHE DA LAVA OTIMIZADO (SEM LAG) ──────────────────
local cachedLava = nil
local lastLavaCheck = 0

local function GetLavaHeight()
    if tick() - lastLavaCheck < 3 then
        if cachedLava and cachedLava.Parent then
            return cachedLava.Position.Y + (cachedLava.Size.Y / 2)
        end
        return -math.huge
    end
    
    lastLavaCheck = tick()
    cachedLava = nil
    local lavaHeight = -math.huge
    
    local mapFolder = workspace:FindFirstChild("Map")
    if mapFolder then
        for _, obj in pairs(mapFolder:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name == "RisingLava" or obj.Name:lower():find("lava")) then
                cachedLava = obj
                local topY = obj.Position.Y + (obj.Size.Y / 2)
                if topY > lavaHeight then lavaHeight = topY end
            end
        end
    end
    return lavaHeight
end

-- ─── DETECTOR DE TEMPO RESTANTE DA BOMBA ─────────────────
local function GetBombTime()
    local debris = workspace:FindFirstChild("Debris")
    local defaultFolder = debris and debris:FindFirstChild("Default")
    local bombTimer = defaultFolder and defaultFolder:FindFirstChild("BombTimer")
    
    if bombTimer and bombTimer:IsA("ValueBase") then
        return tonumber(bombTimer.Value) or 99
    elseif bombTimer and bombTimer:IsA("BasePart") then
        local textLabel = bombTimer:FindFirstChildWhichIsA("TextLabel", true)
        if textLabel then
            local timeText = textLabel.Text:match("[%d%.]+")
            return tonumber(timeText) or 99
        end
    end
    return 99
end

-- ─── FUNÇÃO GRUDE MAGNÉTICO (COLADO NO INIMIGO) ───
local function TeleportToNearest()
    local myHRP = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local nearestPlayer, shortestDistance = nil, math.huge
    
    for _, other in pairs(Players:GetPlayers()) do
        if other ~= Player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
            local char = other.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local head = char:FindFirstChild("Head")
            
            if not hum or hum.Health <= 0 then continue end
            if head and head.Transparency > 0.5 then continue end
            
            local bomb = workspace:FindFirstChild("Bomb")
            if bomb and bomb:FindFirstChild(other.Name) then continue end
            
            local dist = (char.HumanoidRootPart.Position - myHRP.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                nearestPlayer = char.HumanoidRootPart
            end
        end
    end
    
    if nearestPlayer then 
        myHRP.CFrame = nearestPlayer.CFrame
    end
end

