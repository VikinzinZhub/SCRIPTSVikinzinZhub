                AntiLavaPlatform.Size = Vector3.new(2000, 2, 2000)
                AntiLavaPlatform.Anchored = true
                AntiLavaPlatform.Material = Enum.Material.SmoothPlastic
                AntiLavaPlatform.Transparency = 0 
                AntiLavaPlatform.Color = Color3.fromRGB(255, 255, 255) 
                AntiLavaPlatform.Parent = workspace
            end
            AntiLavaPlatform.CFrame = CFrame.new(0, targetY, 0)
            
            local char = Player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Position.Y < (targetY - 1.5) then
                hrp.CFrame = CFrame.new(hrp.Position.X, targetY + 4, hrp.Position.Z)
                hrp.Velocity = Vector3.new(0, 0, 0)
            end
        else
            LavaAvisoLabel.Visible = false
            if AntiLavaPlatform then AntiLavaPlatform:Destroy() AntiLavaPlatform = nil end
        end
    end)
end
