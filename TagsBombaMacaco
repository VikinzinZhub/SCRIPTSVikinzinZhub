-- ─── LÓGICA ANTI-CONFLITO DO MINI MENU ───────────────────────────
local stabilityForce = nil

local function LoopMiniMenuFunes()
    while getgenv().VikinzinZ_Storage.AutoAntiBomb or getgenv().VikinzinZ_Storage.AutoFugaBomb do
        local bombFolder = workspace:FindFirstChild("Bomb")
        local comBomba = bombFolder and bombFolder:FindFirstChild(Player.Name)

        if getgenv().VikinzinZ_ManualSky and not comBomba then 
            task.wait(0.01) 
            continue 
        end

        local myCharacter = Player.Character
        local myHRP = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        if myHRP and bombFolder then
            if not stabilityForce or stabilityForce.Parent ~= myHRP then
                if stabilityForce then stabilityForce:Destroy() end
                stabilityForce = Instance.new("BodyVelocity")
                stabilityForce.Velocity = Vector3.new(0, 0, 0)
                stabilityForce.MaxForce = Vector3.new(0, math.huge, 0)
                stabilityForce.Parent = myHRP
            end

            if comBomba then
                if getgenv().VikinzinZ_Storage.AutoAntiBomb then
                    SetNoclip(true) 
                    stabilityForce.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    TeleportToNearest()
                else
                    SetNoclip(false)
                    stabilityForce.MaxForce = Vector3.new(0, 0, 0)
                end
            else
                local timeRemaining = GetBombTime()
                local perigoPerto = false
                
                if getgenv().VikinzinZ_Storage.AutoFugaBomb then
                    for _, bomber in pairs(bombFolder:GetChildren()) do
                        if bomber:IsA("Model") and bomber:FindFirstChild("HumanoidRootPart") and bomber.Name ~= Player.Name then
                            local posInimigo = Vector3.new(bomber.HumanoidRootPart.Position.X, 0, bomber.HumanoidRootPart.Position.Z)
                            local posMinha = Vector3.new(myHRP.Position.X, 0, myHRP.Position.Z)
                            local dist = (posInimigo - posMinha).Magnitude
                            if dist < 25 then perigoPerto = true break end
                        end
                    end
                end
                
                if (timeRemaining <= 5 or perigoPerto) and getgenv().VikinzinZ_Storage.AutoFugaBomb then
                    SetNoclip(true) 
                    stabilityForce.MaxForce = Vector3.new(0, math.huge, 0)
                    myHRP.CFrame = CFrame.new(myHRP.Position.X, 400, myHRP.Position.Z)
                else
                    SetNoclip(false)
                    stabilityForce.MaxForce = Vector3.new(0, 0, 0)
                end
            end
        else
            if stabilityForce then stabilityForce:Destroy() stabilityForce = nil end
        end
        task.wait(0.01)
    end
    if stabilityForce and not getgenv().VikinzinZ_ManualSky then stabilityForce:Destroy() stabilityForce = nil end
    if not getgenv().VikinzinZ_ManualSky then SetNoclip(false) end
end

local function ForcarLoopMiniMenu()
    if getgenv().VikinzinZ_Storage.AutoAntiBomb or getgenv().VikinzinZ_Storage.AutoFugaBomb then
        task.spawn(LoopMiniMenuFunes)
    end
end

